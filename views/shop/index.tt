[%# Shop - front page

Authors:
    Mark Smith <mark@dreamwidth.org>

Copyright (c) 2015 by Dreamwidth Studios, LLC.

This program is free software; you may redistribute it and/or modify it under
the same terms as Perl itself.  For a copy of the license, please reference
'perldoc perlartistic' or 'perldoc perlgpl'.
%]
[%- sections.title = '.title' | ml(sitename = site.name) -%]

[% cart_display %]

<p>[% '.about' | ml %]</p>

<div class="row">
    <div class="small-12 medium-6 columns">
        <div class="panel">
            <h2>[% '.title.paidacc' | ml %]</h2>
            <ul>
                [% IF remote AND remote.is_personal %]
                    [% UNLESS remote.is_perm %]
                        <li><a href="[% site.shoproot | html %]/account?for=self">[% '.for.self' | ml %]</a> ([% remote.ljuser_display %])</li>
                    [% END %]
                    <li><a href="[% site.shoproot | html %]/gifts?type=account">[% '.for.circle' | ml %]</a></li>
                    <li><a href="[% site.shoproot | html %]/account?for=gift">[% '.for.different' | ml %]</a></li>
                [% ELSE %]
                    <li><a href="[% site.shoproot | html %]/account?for=gift">[% '.for.existing' | ml %]</a></li>
                [% END %]
                <li><a href="[% site.shoproot | html %]/account?for=new">[% '.for.new' | ml %]</a></li>
                <li><a href="[% site.shoproot | html %]/randomgift">[% '.for.random' | ml %]</a></li>
            </ul>
        </div>
    </div>
    <div class="small-12 medium-6 columns">
        <div class="panel">
            <h2>[% '.title.points' | ml(site=site.nameshort) %]</h2>
            [% IF NOT shop_config.points %]
                <p>[% '.points.unavailable' | ml %]</p>
            [% ELSIF remote AND remote.is_personal %]
                <ul>
                    <li><a href="[% site.shoproot | html %]/points?for=self">[% '.for.self' | ml %]</a> ([% remote.ljuser_display %])</li>
                    <li><a href="[% site.shoproot | html %]/points?for=gift">[% '.for.different' | ml %]</a></li>
                </ul>
            [% ELSE %]
                <p>[% '.points.login' | ml %]</p>
            [% END %]
        </div>
    </div>
</div>

<div class="row">
    <div class="small-12 medium-6 columns">
        <div class="panel">
            <h2>[% '.title.renames' | ml %]</h2>
            [% IF NOT shop_config.rename %]
                <p>[% '.renames.unavailable' | ml %]</p>
            [% ELSIF remote AND remote.is_personal %]
                <ul>
                    <li><a href="[% site.shoproot | html %]/renames?for=self">[% '.for.self' | ml %]</a> ([% remote.ljuser_display %])</li>
                    <li><a href="[% site.shoproot | html %]/renames?for=gift">[% '.for.different' | ml %]</a></li>
                </ul>
            [% ELSE %]
                <p>[% '.renames.login' | ml %]</p>
            [% END %]
        </div>
    </div>
    <div class="small-12 medium-6 columns">
        <div class="panel">
            <h2>[% '.title.icons' | ml %]</h2>
            [% IF shop_config.icons %]
                <ul>
                    [% IF remote AND remote.is_personal %]
                        <li><a href="[% site.shoproot | html %]/icons?for=self">[% '.for.self' | ml %]</a> ([% remote.ljuser_display %])</li>
                        <li><a href="[% site.shoproot | html %]/icons?for=gift">[% '.for.different' | ml %]</a></li>
                    [% ELSE %]
                        <li><a href="[% site.shoproot | html %]/icons?for=gift">[% '.for.existing' | ml %]</a></li>
                    [% END %]
                </ul>
            [% ELSE %]
                <p>[% '.icons.unavailable' | ml %]</p>
            [% END %]
        </div>
    </div>
</div>
