[%# Shop - Transfer points to another user

Authors:
    Mark Smith <mark@dreamwidth.org>

Copyright (c) 2015-2018 by Dreamwidth Studios, LLC.

This program is free software; you may redistribute it and/or modify it under
the same terms as Perl itself.  For a copy of the license, please reference
'perldoc perlartistic' or 'perldoc perlgpl'.
%]
[%- sections.title = '.title' | ml(sitename = site.nameshort) -%]
[%- CALL dw.active_resource_group( "foundation" ) -%]

<div class="row">
    <div class="small-12 medium-10 large-8 columns end">
        [% IF transferred %]
            <div class="alert-box success radius" role="status">
                [% '.transferred' | ml(points = points, user = foru.ljuser_display) %]
                [% IF anon; '.transferred.anon' | ml; ELSE; '.transferred.notify' | ml; END %]
            </div>

        [% ELSIF confirm %]
            <hr />
            <div>
                <p>[% IF foru.userpic; foru.userpic.imgtag_lite; END %]
                    [% IF anon;
                        '.request.anon' | ml(points = points, user = foru.ljuser_display, name = foru.name_html);
                    ELSE;
                        '.request.user' | ml(points = points, user = foru.ljuser_display, name = foru.name_html);
                    END %]</p>
                [% IF reason %]
                    [% IF can_have_reason %]
                        <p>[% '.note.y' | ml %]</p>
                        <blockquote>[% reason | html | html_para %]</blockquote>
                    [% ELSE %]
                        <p>[% '.note.n' | ml %]</p>
                    [% END %]
                [% END %]
                <p>[% '.confirm2' | ml %]</p>
            </div>
            <hr />

            <form method="post">
                [% dw.form_auth %]
                [% form.hidden(name = 'foruser', value = foru.user) %]
                [% form.hidden(name = 'points', value = points) %]
                [% form.hidden(name = 'reason', value = reason) %]
                [% form.hidden(name = 'anon', value = anon) %]
                [% form.hidden(name = 'confirm', value = 1) %]
                [% form.submit(value = dw.ml('.btn.confirm'), class = 'button primary') %]
            </form>

        [% ELSE %]
            <p>[% '.about' | ml(sitename = site.nameshort) %]</p>

            [% IF ! has_points %]
                <div class="panel callout radius">
                    <p>[% '.about.nopoints' | ml(sitename = site.nameshort, aopts = "href='$site.shoproot/points'") %]</p>
                </div>
            [% ELSE %]
                <p>[% '.about.points' | ml(points = has_points) %]</p>

                <form method="post" class="panel radius">
                    [% dw.form_auth %]
                    <div class="row">
                        <div class="small-12 medium-6 columns[% ' error' IF errs.foruser %]">
                            [% IF foru %]
                                <p>[% dw.ml('.buying.for') %] [% foru.ljuser_display %]</p>
                                [% form.hidden(name = 'foruser', value = foru.user) %]
                            [% ELSE %]
                                <label for="foruser">[% dw.ml('.buying.for') %]</label>
                                [% IF errs.foruser %]
                                    [% form.textbox(name = 'foruser', id = 'foruser', maxlength = 25,
                                        'aria-invalid' = 'true', 'aria-describedby' = 'foruser-error') %]
                                    <small class="error" id="foruser-error">[% errs.foruser | html %]</small>
                                [% ELSE %]
                                    [% form.textbox(name = 'foruser', id = 'foruser', maxlength = 25) %]
                                [% END %]
                            [% END %]
                        </div>
                        <div class="small-12 medium-6 columns[% ' error' IF errs.points %]">
                            <label for="points">[% dw.ml('.buying.points') %]</label>
                            [% amount = formdata ? formdata.points : points %]
                            <input type="number" name="points" id="points" value="[% amount | html %]"
                                aria-describedby="points-range[% ' points-error' IF errs.points %]"
                                [% 'aria-invalid="true"' IF errs.points %] />
                            [% IF errs.points %]
                                <small class="error" id="points-error">[% errs.points | html %]</small>
                            [% END %]
                            <small id="points-range">[% dw.ml('.buying.points.range') %]</small>
                        </div>
                    </div>
                    <div class="row">
                        <div class="small-12 columns">
                            [% form.checkbox(name = 'anon', id = 'anon', value = 1,
                                selected = anon, label = dw.ml('.anon')) %]
                        </div>
                    </div>
                    [% form.submit(value = dw.ml('.btn.transfer'), class = 'button primary') %]
                </form>
            [% END %]
        [% END %]
    </div>
</div>
