%]

[% sections.title = 'Manage Form Messages' %]

<p>Save frequently used subjects and messages for other sendmail administrators to use.</p>
<p><a href="/admin/sendmail/index">Compose an email</a></p>

<h2>Saved Form Messages</h2>
[% IF forms.size %]
    <ul>
    [% FOREACH item IN forms %]
        <li><a href="/admin/sendmail/forms?id=[% item.formid | url %]">[% item.name | html %]</a></li>
    [% END %]
    </ul>
[% ELSE %]
    <p>No form messages have been saved.</p>
[% END %]

[% IF form_id %]
    <h2>Edit Form Message</h2>
    <p><a href="/admin/sendmail/forms">Create a new form message</a></p>
[% ELSE %]
    <h2>New Form Message</h2>
[% END %]

[% INCLUDE components/errors.tt errors = errors %]

<form method="post" action="/admin/sendmail/forms">
    [% dw.form_auth %]
    <input type="hidden" name="action" value="save" />
    [% IF form_id %]<input type="hidden" name="id" value="[% form_id | html %]" />[% END %]
    <p>[% form.textbox( label = 'Name', name = 'name', maxlength = 255, size = 50 ) %]</p>
    <p>[% form.textbox( label = 'Subject', name = 'subject', maxlength = 255, size = 50 ) %]</p>
    <p>[% form.textarea( label = 'Message', name = 'message', rows = 10, cols = 80,
                         style = 'vertical-align: top' ) %]</p>
    <p>[% form.submit( value = 'Save form message' ) %]</p>
</form>

[% IF form_id %]
    <form method="post" action="/admin/sendmail/forms">
        [% dw.form_auth %]
        <input type="hidden" name="action" value="delete" />
        <input type="hidden" name="id" value="[% form_id | html %]" />
        <p>[% form.submit( value = 'Delete form message' ) %]</p>
    </form>
[% END %]
