[%# View the properties set on a particular entry.

Authors:
    Afuna <coder.dw@afunamatata.com>

Copyright (c) 2015 by Dreamwidth Studios, LLC.

This program is free software; you may redistribute it and/or modify it under
the same terms as Perl itself.  For a copy of the license, please reference
'perldoc perlartistic' or 'perldoc perlgpl'.
%]

[%- sections.title = ".admin.link" | ml -%]
[%- CALL dw.active_resource_group( "foundation" ) -%]


<div class="row"><div class="columns">
<form method="POST">
<div class="row"><div class="columns">
    [%- form.textbox(
            label = "View properties for URL: "
            name = 'url',
            maxlength = 100
    ) -%]
</div></div>
<div class="row"><div class="columns">
    [%- form.submit( value = "View" ) -%]
</div></div>
</form>
</div></div>

[%- IF entry -%]
    <hr>
    <div class="row"><div class="columns">
        <strong>Subject:</strong> <a href="[% entry.url | html %]">[%- entry.subject -%]</a>
    </div></div>
    <div class="row"><div class="columns">
        <strong>Poster:</strong> [% entry.poster %]
    </div></div>
    <div class="row"><div class="columns">
        <strong>Journal:</strong> [% entry.journal %]
    </div></div>
    <div class="row"><div class="columns">
        <strong>Security</strong> [% entry.security | html %]
        (journal wide minsecurity): [% entry.minsecurity | html %]
    </div></div>
    <div class="row"><div class="columns">
        <strong>User Date/Time:</strong> [% entry.user_time | html %]
    </div></div>
    <div class="row"><div class="columns">
        <strong>Server Date/Time:</strong> [% entry.server_time | html %]
    </div></div>
    <div class="row"><div class="columns">
        <strong>Journal Adult Content:</strong> [% entry.adult_content | html %]
    </div></div>
    [%- IF saved -%]
        <p role="status">Changes saved.</p>
    [%- END -%]
    [%- IF can_save -%]
        <form method="POST">
        [%- dw.form_auth -%]
        [%- form.hidden( name = 'url', value = entry.edit_url ) -%]
        [%- form.hidden( name = '_save', value = 1 ) -%]
        <p>Only properties with an edit field can be changed here. Leave a field blank to remove its property; a literal 0 is not supported.</p>
    [%- END -%]
    <ul>
    [%- FOR prop = props -%]
        <li>
            [%- IF can_save && prop.field -%]
                [%- form.hidden( name = prop.baseline_field, value = prop.baseline ) -%]
                [%- IF prop.textarea_value -%]
                    [%- form.textarea(
                        label = prop.name,
                        name = prop.field,
                        value = prop.textarea_value,
                        maxlength = max_prop_chars,
                        rows = 2
                    ) -%]
                [%- ELSE -%]
                    [%- form.textbox(
                        label = prop.name,
                        name = prop.field,
                        value = prop.raw_value,
                        maxlength = max_prop_chars
                    ) -%]
                [%- END -%]
            [%- ELSE -%]
                <strong>[%- prop.name | html -%]:</strong> [% prop.value | html %]<br>
            [%- END -%]
            <small>[%- prop.description | html -%]</small>
        </li>
    [%- END -%]
    </ul>
    [%- IF can_save -%]
        [%- form.submit( value = 'Save' ) -%]
        </form>
    [%- END -%]
[%- END -%]
