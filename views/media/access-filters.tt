[%# media/access-filters.tt

Custom access filters for an image.

Authors:
    Dreamwidth contributors

Copyright (c) 2026 by Dreamwidth Studios, LLC.

This program is free software; you may redistribute it and/or modify it under
the same terms as Perl itself.  For a copy of the license, please reference
'perldoc perlartistic' or 'perldoc perlgpl'.
%]
[% IF custom_groups.size %]
    <fieldset>
        <legend>Custom access filters</legend>
        <p>These filters apply only when Security is set to Custom. If none are checked, the image is private.</p>
        [% FOREACH group IN custom_groups %]
            <div>
                <label><input type="checkbox" name="[% name | html %]" value="[% group.groupnum | html %]:[% group_revision | html %]"[% IF selected.item(group.groupnum) %] checked[% END %]> [% group.groupname | html %]</label>
            </div>
        [% END %]
    </fieldset>
[% END %]
