[%# manage/circle/edit/purge.tt

Confirmation page for removing purged accounts from a user's circle.

Authors:
    SAPHID <saphid@users.noreply.github.com>

Copyright (c) 2026 by Dreamwidth Studios, LLC.

This program is free software; you may redistribute it and/or modify it under
the same terms as Perl itself. For a copy of the license, please reference
'perldoc perlartistic' or 'perldoc perlgpl'.
%]

[%- sections.title = '.title' | ml -%]
[%- CALL dw.active_resource_group('foundation') -%]

[% IF purged_members.size %]
    <p>[% '.explain' | ml %]</p>
    <ul>
    [% FOREACH member IN purged_members %]
        <li>[% member.display_username | html %]</li>
    [% END %]
    </ul>
    <form method="post">
        [% dw.form_auth() %]
        [% form.submit( name = 'remove_purged', value = dw.ml('.confirm.button') ) %]
        <a href="[% circle_url | html %]" class="secondary button">[% '.cancel' | ml %]</a>
    </form>
[% ELSE %]
    <p>[% '.none' | ml %]</p>
    <a href="[% circle_url | html %]" class="secondary button">[% '.back' | ml %]</a>
[% END %]
