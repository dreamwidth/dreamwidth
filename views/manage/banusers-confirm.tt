[%# manage/banusers-confirm.tt

Confirm banning or unbanning an account from its profile.

Authors:
    SAPHID <saphid@users.noreply.github.com>

Copyright (c) 2026 by Dreamwidth Studios, LLC.

This program is free software; you may redistribute it and/or modify it under
the same terms as Perl itself. For a copy of the license, please reference
'perldoc perlartistic' or 'perldoc perlgpl'.
%]

[%- sections.title = label -%]
[%- CALL dw.active_resource_group( "foundation" ) -%]

<p>Are you sure you want to [% action | html %] [% target.display_username | html %]?</p>
<form method="post" action="[% action_url | html %]">
    [% dw.form_auth %]
    <input type="hidden" name="userid" value="[% target.id | html %]" />
    <input type="hidden" name="action" value="[% action | html %]" />
    <button type="submit" class="button">[% label | html %]</button>
    <a href="[% profile_url | html %]" class="button secondary">Cancel</a>
</form>
