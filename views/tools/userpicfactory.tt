%]

[%- CALL dw.active_resource_group( "foundation" ) -%]
[%- sections.title = '.title' | ml -%]

[%- dw.need_res( { group => "foundation" }, "js/6alib/core.js",
                 "js/6alib/image-region-select.js", "js/userpicfactory.js" ) -%]

[%- sections.head = BLOCK %]
    <style type="text/css">
        .icon-factory {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-start;
            gap: 1rem;
        }
        #picContainer, .icon-factory-options {
            max-width: 100%;
        }
        .icon-factory-options {
            box-sizing: border-box;
        }
        .icon-factory-options ul {
            list-style: none;
            margin-left: 0;
            padding-left: 0;
        }
        .icon-factory-options label {
            display: inline;
        }
        .icon-factory-options .button {
            margin-bottom: 0;
        }
        #prevcon {
            width: 100px;
            height: 100px;
            overflow: hidden;
            box-sizing: content-box;
            border: 1px solid transparent;
            margin-bottom: 0.5em;
        }
        #userpicpreview {
            max-width: none;
            display: block;
        }
    </style>

[% END %]

[%- IF successcount -%]
    <p>[% '.success' | ml( num = successcount ) %]</p>
[%- END -%]

<a href="/manage/icons">[% '.backtext' | ml %]</a>

[%- IF no_index -%]
    <p>[% '.error.noindex' | ml( pagelink = dw.create_url( '/manage/icons' ) ) %]</p>
[%- ELSE -%]
    <noscript><p style="font-weight: bold;">[% '.noscript' | ml %]</p></noscript>
    <p>[% '.howtouse' | ml %]</p>

[%- picpath = dw.create_url( "/misc/mogupic", keep_args => [ 'authas', 'index' ] ) -%]

    <div class="icon-factory">
    <div id="picContainer" hidden>
      <img src="[% picpath %]" id="userpic" alt="" />
    </div>
    <form class="highlight-box icon-factory-options"
          action="[% dw.create_url( '/manage/icons', keep_args => [ 'authas' ] ) %]"
          method="POST" enctype='multipart/form-data'>
    <ul><li>
      <input type="checkbox" id="constrain" onchange="setConstrain();" />
      <label for="constrain">[% '.preview.label.constrain' | ml %]</label>
      <br /><small>[% '.preview.label.constrain.shift' | ml %]</small>
    </li><li>
      <input type="checkbox" id="borderToggle" name="border" />
      <label for="borderToggle">[% '.preview.label.bordertoggle' | ml %]</label>
    </li></ul>
    <small>[% '.preview.label.icon' | ml %]</small>
    <div id="prevcon">
      <img src="[% picpath %]" id="userpicpreview" alt="" />
    </div>

[% form.hidden( name = "create", value = 1 ) %]

[%- x1 = 20; y1 = 20; x2 = upf_w - 20; y2 = upf_h - 20 -%]

[% form.hidden( id = "x1", name = "x1", value = x1 ) %]
[% form.hidden( id = "y1", name = "y1", value = y1 ) %]
[% form.hidden( id = "x2", name = "x2", value = x2 ) %]
[% form.hidden( id = "y2", name = "y2", value = y2 ) %]

[% form.hidden( id = "scaledSizeMax", name = "scaledSizeMax", value = scaledSizeMax ) %]

[% form.hidden( name = "src", value = "factory" ) %]
[% dw.form_auth %]

[% form.submit( id = "createbtn", class = "button", value = dw.ml( ".title" ) ) %]
[% form_keepargs %]

    </form></div>

[%- END -%]
