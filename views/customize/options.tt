[%- sections.title = title -%]
[%- sections.head = headextra -%]
[%- CALL dw.active_resource_group( 'foundation' ) -%]

[% IF errors.size %]<div class="alert-box alert">[% errors.join('<br />') %]</div>[% END %]
<form action="[% dw.create_url('/customize/options', keep_args => []) %]" method="get" class="theme-switcher">[% authas_html %]</form>
[% IF widget_authas %]<input type="hidden" name="authas" value="[% widget_authas %]" id="_widget_authas" />[% END %]
<div class="theme-current pkg">[% current_theme %]</div>
<div class="theme-titles pkg">[% journal_titles %]</div><br />
<div class="customize-wrapper one-percent">[% customize_theme %]</div>
<a name="layout"></a><div class="layout-selector-wrapper pkg">[% layout_chooser %]</div>
<h2 class="widget-header">[% dw.ml('.advanced') %]</h2>
<a href="advanced/">[% dw.ml('.advanced') %]</a>
