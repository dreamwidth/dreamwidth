'perldoc perlartistic' or 'perldoc perlgpl'.
-%]

[% IF customgroups.size > 0 %]
    <fieldset id="js-custom-groups" class="custom-groups">
        <legend>[% ".header.custom" | ml %]</legend>
        <noscript><p>[% ".instructions.nojs" | ml %]</p></noscript>
        <ul class="no-bullet">
            [% FOREACH group IN customgroups %]
                <li>[%- form.checkbox( label = group.label
                            name = "custom_bit"
                            id = "custom-bit-$group.value"
                            value = group.value
                ) -%]</li>
            [% END %]
        </ul>
        <div hidden>
            <h3>[% ".header.custom_member" | ml %]</h3>
            <ul class="no-bullet" id="js-custom-group-members"></ul>
        </div>
    </fieldset>
[% END %]
