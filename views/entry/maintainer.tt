[%# Community maintainer entry-management surface: read-only entry context plus
    the administrator override box. A maintainer may change the override props
    or delete the entry, but never edit the subject or body. %]
[%- sections.title = '/entry/form.tt.title.edit' | ml -%]
[%- delete_confirm = "entryform.delete.confirm" | ml | js -%]
[%- deletespam_confirm = "entryform.deletespam.confirm" | ml | js -%]
[%# Subject and body are raw text in read-only controls outside the form: a
   maintainer cannot edit them, nothing is submitted, and moderating spam does
   not load the entry's images or embeds. %]
<table summary='' class='entry-maintainer-context'>
    <tr><th>[% '.poster' | ml %]</th>
        <td>[% entry.poster.ljuser_display %] [% '.incommunity' | ml %] [% journal.ljuser_display %]</td></tr>
    <tr><th>[% 'entryform.date' | ml %]</th>
        <td>[% eventtime | html %]</td></tr>
    <tr><th>[% 'entryform.subject' | ml %]</th>
        <td><input type="text" readonly size="50" value="[% entry.subject_raw | html %]"></td></tr>
</table>
<textarea readonly rows="15" style="width: 100%;">[% entry.event_raw | html %]</textarea>
<form method="post" action="[% action | html %]" class="entry-maintainer-form">[% dw.form_auth() %]
<fieldset class='highlight-box'>
<legend>[% 'entryform.maintainer' | ml %]</legend>
[% IF adult_content_enabled %]
<p><label>[% 'entryform.adultcontent.maintainer' | ml %]
<select name="prop_adult_content_maintainer">
<option value="">[% dw.ml('entryform.adultcontent.poster', setting=dw.ml('entryform.adultcontent.' _ (props.adult_content || 'default'))) %]</option>
<option value="none"[% ' selected' IF props.adult_content_maintainer == 'none' %]>[% 'entryform.adultcontent.none' | ml %]</option>
<option value="concepts"[% ' selected' IF props.adult_content_maintainer == 'concepts' %]>[% 'entryform.adultcontent.concepts' | ml %]</option>
<option value="explicit"[% ' selected' IF props.adult_content_maintainer == 'explicit' %]>[% 'entryform.adultcontent.explicit' | ml %]</option>
</select></label></p>
<p><label>[% 'entryform.adultcontentreason.maintainer' | ml %]
<input maxlength="255" name="prop_adult_content_maintainer_reason" value="[% props.adult_content_maintainer_reason | html %]"></label></p>
[% END %]
[% UNLESS props.opt_nocomments %]<p>[% form.checkbox(name='prop_opt_nocomments_maintainer', value='1', selected=props.opt_nocomments_maintainer, label=dw.ml('entryform.comment.disable')) %]</p>[% END %]
</fieldset>
[% form.submit(name='action:savemaintainer', value=dw.ml('entryform.save.maintainer')) %]
[% form.submit(name='action:delete', id='js-manager-delete-button', value=dw.ml('entryform.delete'), onclick="return confirm(" _ delete_confirm _ ")") %]
[% form.submit(name='action:deletespam', id='js-manager-deletespam-button', value=dw.ml('entryform.deletespam'), onclick="return confirm(" _ deletespam_confirm _ ")") %]
</form>
