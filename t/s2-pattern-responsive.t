use strict;
use warnings;

use Test::More;
BEGIN { $LJ::_T_CONFIG = 1; require "$ENV{LJHOME}/cgi-bin/ljlib.pl"; }
use LJ::S2;
use S2;
use S2::Compiler;

sub layer_source {
    my ($name) = @_;
    open my $file, '<', "$ENV{LJHOME}/styles/$name.s2" or die "Cannot read $name: $!";
    local $/;
    return <$file>;
}

my $compiler = S2::Compiler->new( {} );

sub compile_layer {
    my ( $id, $type, $source ) = @_;
    my $compiled;
    eval {
        $compiler->compile_source(
            {
                type           => $type,
                source         => \$source,
                output         => \$compiled,
                layerid        => $id,
                builtinPackage => 'S2::Builtin::LJ',
            }
        );
        S2::load_layer( $id, $compiled, 1 );
        1;
    } or BAIL_OUT("Could not compile and load S2 $type layer: $@");
    pass("Compiled and loaded S2 $type layer");
}

sub stylesheet {
    my (@layers) = @_;
    my $context = S2::make_context(@layers);
    $context->[S2::SCRATCH] = {};
    LJ::S2::populate_system_props($context);
    my $css = '';
    local $S2::pout   = sub { $css .= $_[0] };
    local $S2::pout_s = $S2::pout;
    S2::Builtin::LJ::start_css($context);
    S2::run_code( $context, 'Page::print_default_stylesheet()', {} );
    S2::run_code( $context, 'print_stylesheet()' );
    S2::run_code( $context, 'Page::print_theme_stylesheet()', {} );
    S2::Builtin::LJ::end_css($context);
    return $css;
}

sub media_rules {
    my ( $css, $width ) = @_;
    my $query = qr/\@media\s+only\s+screen\s+and\s+\(\s*min-width\s*:\s*\Q$width\E\s*\)/;
    return join "\n", $css =~ /$query\s*\{((?:[^{}]++|\{[^{}]*\})*)\}/g;
}

compile_layer( 1, 'core',   layer_source('core2') );
compile_layer( 2, 'layout', layer_source('core2base/layout') . layer_source('pattern/layout') );

my ( undef, %themes ) = split /^#NEWLAYER:\s+(\S+)\n/m, layer_source('pattern/themes');
my $theme_id = 3;
for my $theme (
    [ 'lightasafeather', '45em', '60em', '20%', '15em' ],
    [ 'elementarysmoke', '36em', '48em', '15%', '24em' ],
    )
{
    my ( $name, $medium, $large, $margin, $sidebar_space ) = @$theme;
    subtest $name => sub {
        compile_layer( $theme_id, 'theme', $themes{"pattern/$name"} );
        my $css     = stylesheet( 1, 2, $theme_id );
        my $base    = $css =~ s/\@media[^{}]+\{(?:[^{}]++|\{[^{}]*\})*\}//gr;
        my $desktop = media_rules( $css, $medium );
        my $wide    = media_rules( $css, $large );

        my $gutter_rule  = qr/#header-wrapper\s*,\s*#content\s*\{[^}]*margin-inline\s*:\s*/;
        my $gutter_value = qr/clamp\([^}]*\Q$sidebar_space\E[^}]*\Q$margin\E/;

        ok(
            $base !~ /#(?:header|title)-content\s*\{[^}]*border-(?:left|right)\s*:/,
            'narrow headers do not reserve room for floated modules'
        );
        ok( $base !~ /#header-wrapper\s*,\s*#content\s*\{[^}]*margin-(?:left|right|inline)\s*:/,
            'narrow entries are not squeezed by desktop gutters' );
        ok( $base !~ /\.(?:entry|comment)-content\s*,[^{}]+\{[^}]*margin-(?:left|right)\s*:/,
            'narrow entries do not reserve a column for userpics' );
        ok(
            $desktop =~ /#header-secondary\s*\{[^}]*float\s*:\s*right\b/,
            'profile module floats beside the journal title on wider screens'
        );
        ok(
            $desktop =~ /#title-secondary\s*\{[^}]*float\s*:\s*right\b/,
            'title modules float beside the journal title on wider screens'
        );
        ok( $desktop =~ /$gutter_rule$gutter_value/,
            'wide gutters use the theme setting and allow room for its columns' );
        ok(
            $wide =~ /\.(?:entry|comment) \.userpic\s*\{[^}]*float\s*:\s*left\b/,
            'userpics retain their side-by-side layout on large screens'
        );
    };
    $theme_id++;
}

done_testing;
