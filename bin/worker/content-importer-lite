# the same terms as Perl itself.  For a copy of the license, please reference
# 'perldoc perlartistic' or 'perldoc perlgpl'.
#

use strict;
BEGIN {
    require "$ENV{LJHOME}/cgi-bin/ljlib.pl";
}

use LJ::Worker::TheSchwartz;
use DW::Importer::Job;
use DW::Importer::Registry;

# the registry says which worker classes this process runs
foreach my $class ( DW::Importer::Registry->classes_for_process( 'content-importer-lite' ) ) {
    eval "require $class; 1" or die $@;
    schwartz_decl( $class );
}

# some jobs leak memory and ask for the process to be replaced once they are done
schwartz_on_afterwork( sub { exit 0 if DW::Importer::Job->exit_requested } );

$0 = 'content-importer [bored]';

schwartz_work();
