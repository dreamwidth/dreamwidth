# 'perldoc perlartistic' or 'perldoc perlgpl'.
#

use v5.10;
use strict;
BEGIN { require "$ENV{LJHOME}/cgi-bin/ljlib.pl"; }

use Carp qw/ croak /;
use Getopt::Long;

use DW::Logic::Importer;
use DW::Task::SearchCopier;
use DW::Importer::Job;
use DW::Importer::LogStore;
use DW::Importer::Logger;
use DW::Importer::Registry;
use DW::Importer::Report;


my ( $user, $list, $log_id, $run, $dry_run, $verbose, $type, $import_id, $schedule_copy );
GetOptions(
    'user=s' => \$user,
    'list' => \$list,
    'log=i' => \$log_id,
    'run' => \$run,
    'dry-run' => \$dry_run,
    'verbose' => \$verbose,
    'type=s' => \$type,
    'import-id=i' => \$import_id,
    'schedule-search-copy' => \$schedule_copy,
);

# print one stored import log; it needs no user, the log id says whose it is
if ( defined $log_id ) {
    my $row = DW::Importer::LogStore->log( $log_id )
        or croak "No import log $log_id";
    my ( $text, $missing ) = DW::Importer::LogStore->content( $row );
    binmode STDOUT, ':raw';    # the log is UTF-8 bytes already
    print $text;
    warn "$missing of $row->{chunks} chunks could not be retrieved (expired?)\n" if $missing;
    exit 0;
}

my $u = LJ::load_user( $user )
    or croak "Usage: $0 ( -u USER [ --list | --run --type lj_entries [--import-id N] | --dry-run [--type lj_entries] [--import-id N] [--verbose] | --schedule-search-copy ] | --log LOGID )";
my $dbh = LJ::get_db_writer();
my $dbcm = LJ::get_cluster_master( $u )
    or croak "No DB!";

if ( $list ) {
    my $rows = $dbh->selectall_arrayref(q{
            SELECT i.userid, i.item, i.status, i.created, i.last_touch, i.import_data_id,
                   i.priority, d.hostname, d.username, d.usejournal
            FROM import_items i INNER JOIN import_data d
                ON i.userid = d.userid AND i.import_data_id = d.import_data_id
            WHERE i.userid = ?
            ORDER BY i.import_data_id, i.item
        }, undef, $u->id);
    croak $dbh->errstr if $dbh->err;

    # each import's items, then its logs (read them with --log)
    my $print_logs = sub {
        foreach my $l ( @{ DW::Importer::LogStore->logs_for( $u->id, $_[0] ) } ) {
            printf "    log %-8d %-16s %s %8d bytes  %s\n", $l->{logid}, $l->{item},
                scalar( localtime $l->{started} ), $l->{bytes}, $l->{host} // '';
        }
    };

    my $last_id;
    foreach my $r ( @$rows ) {
        if ( defined $last_id && $last_id != $r->[5] ) {
            $print_logs->( $last_id );
            print "\n";
        }
        $last_id = $r->[5];
        printf "%-3d %25s %-16s %-10s %-5s %-5s\n",
            $r->[5], "$r->[8]\@$r->[7]:$r->[9]", $r->[1], $r->[2], ago( $r->[3] ), ago( $r->[4] );
    }
    $print_logs->( $last_id ) if defined $last_id;
    print "\n";
    exit 0;
}

if ( $schedule_copy ) {
    DW::TaskQueue->dispatch(
        DW::Task::SearchCopier->new( { userid => $u->id, source => "importen" } )
    );
    print "Scheduled copier job.\n";
    exit 0;
}

# Pretend to run the import and say what it would have done: nothing is written locally, no
# one is notified and the import's status is untouched. With --type it runs that one item
# (reading, not writing, what earlier items would have left); without it, the whole chain.
if ( $dry_run ) {
    my $tmpdata;
    if ( defined $import_id ) {
        $tmpdata = DW::Logic::Importer->get_import_data( $u, $import_id );
    } else {
        $tmpdata = DW::Logic::Importer->get_import_data_for_user( $u );
    }
    croak "No imports found for user"
        unless $tmpdata && scalar @$tmpdata == 1;

    my %args = (
        userid         => $u->id,
        import_data_id => $tmpdata->[0]->[0],
        $verbose ? ( logger => DW::Importer::Logger->new( fh => \*STDERR ) ) : (),
    );

    my $report;
    if ( defined $type ) {
        croak "--type must be one of: " . join( ', ', map { $_->{name} } DW::Importer::Registry->items )
            unless DW::Importer::Registry->item( $type );
        $report = DW::Importer::Report->new;
        DW::Importer::Job->dry_run( %args, item => $type, report => $report );
    } else {
        $report = DW::Importer::Job->dry_run_chain( %args );
    }

    print $report->as_text;
    exit 0;
}

if ( $run ) {
    my $item = DW::Importer::Registry->item( $type );
    if ( ! defined $item ) {
        croak "--type must be one of: " . join( ', ', map { $_->{name} } DW::Importer::Registry->items );
    }

    my $class = $item->{class};
    eval "require $class; 1" or die $@;

    my $tmpdata;
    if ( defined $import_id ) {
        $tmpdata = DW::Logic::Importer->get_import_data( $u, $import_id );
    } else {
        $tmpdata = DW::Logic::Importer->get_import_data_for_user( $u );
    }
    croak "No imports found for user"
        unless $tmpdata && scalar @$tmpdata == 1;

    # Attempt to actually run the import now
    $class->work( FakeJob->new( arg => {
        userid         => $u->id,
        import_data_id => $tmpdata->[0]->[0],
    } ) );
    exit 0;
}

sub ago {
    my $delta = time() - $_[0];
    if ( $delta > 86400 * 28 ) {
        return int($delta / (86400 * 7)) . 'w';
    } elsif ( $delta > 86400 ) {
        return int($delta / 86400) . 'd';
    } elsif ( $delta > 3600 ) {
        return int($delta / 3600) . 'h';
    } elsif ( $delta > 60 ) {
        return int($delta / 60) . 'm';
    }
    return $delta . 's';
}


################################################################################
## FakeJob class for pretending we have a real job
##

package FakeJob;

sub new {
    my ( $class, %self ) = @_;
    return bless \%self, $class;
}

sub arg { $_[0]->{arg} }
sub grabbed_until {}
sub save {}
sub run_after {}
sub declined {}
sub completed {}
sub failures { 0 }
sub funcname { $_[0] }
sub max_retries { 5 }

sub permanent_failure {
    failed(@_);
}

sub failed {
    say "Failed: $_[1]";
}

sub debug {
   print $_[1]; 
}

